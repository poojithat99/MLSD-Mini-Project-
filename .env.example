# ---------------------------------------------------------------------------
# LLM (Member 2: backend/agents/llm.py). Every model call reads ONLY these.
# No model name, endpoint or key is committed anywhere in the repository (D4).
# ---------------------------------------------------------------------------
# "openai" = any OpenAI-compatible endpoint (hosted free tier, the llm-stub, ...)
# "fake"   = scripted FakeLLM, no network (tests, demos)
LLM_PROVIDER=openai
# OpenAI-compatible base URL of your provider (placeholder; never commit a real one)
LLM_BASE_URL=<your-provider-base-url>
# Model identifier at that provider (placeholder; never commit a real one)
LLM_MODEL=<your-model-id>
# API key (placeholder; put the real key only in your local .env, which must stay untracked)
LLM_API_KEY=<your-api-key>

# Optional second provider used when the primary is down or its breaker is open.
# Leave empty to escalate with reason "provider_unavailable" instead.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Reliability (A5)
# Timeout per attempt, attempts per provider per call
LLM_TIMEOUT_S=20
LLM_MAX_ATTEMPTS=3
# Backoff waits 0.5 s, 1 s, 2 s ... (+ jitter), capped at LLM_BACKOFF_MAX_S
LLM_BACKOFF_BASE_S=0.5
LLM_BACKOFF_MAX_S=8
# Consecutive failures that open the circuit breaker; seconds open before a half-open trial
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_RESET_S=30

# Minimum seconds between model calls per worker process (0 = off); free tier: 60 / RPM x workers
LLM_MIN_INTERVAL_S=0

# Cost per 1,000 tokens in USD, recorded at call time (L5). 0 on a free tier.
LLM_COST_PER_1K_PROMPT=0
LLM_COST_PER_1K_COMPLETION=0

# Demo hooks (only with LLM_PROVIDER=fake):
#   default             normal scripted run
#   fabricate_citation  analyst cites a quote that is not in the corpus -> verifier catches it
# Circuit-breaker demo: LLM_PROVIDER=openai and LLM_BASE_URL=http://127.0.0.1:9 (nothing listens there)
LLM_FAKE_SCENARIO=default

# ---------------------------------------------------------------------------
# Agent run limits and mode (Member 2: backend/agents/state.py, graph.py)
# ---------------------------------------------------------------------------
# Max model calls per run, all agents and retries included
AGENT_MAX_MODEL_CALLS=14
# Max tool calls per run
AGENT_MAX_TOOL_CALLS=16
# Wall-clock limit per run in seconds (raise it if LLM_MIN_INTERVAL_S > 0)
AGENT_WALL_CLOCK_S=60
# on: code pre-fetches the Table 2 row for the delay, RBI 7(i) and RBI 6(i) before the agent starts; off: agent only
AGENT_SEED_PROVISIONS=on
# Evaluation watchdog: seconds before one scenario is recorded as "timeout" and the batch moves on
EVAL_SCENARIO_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# Retrieval embeddings (read by backend/retrieval/config.py and embeddings.py)
# These must match the embedder recorded in data/index/manifest.json, or the
# retriever refuses to load the index.
# ---------------------------------------------------------------------------
# "sentence-transformers" (real) or "hashing" (offline tests only; cannot load the committed index)
EMBEDDING_BACKEND=sentence-transformers
# Embedding model identifier: copy embedder.model from data/index/manifest.json (required)
EMBEDDING_MODEL=<embedding-model-id-from-index-manifest>
# Max tokens per text; must equal the "L=" value in the manifest's embedder name (currently 512)
EMBEDDING_MAX_SEQ_LENGTH=512
# After the embedding model has been downloaded once, load it from the local cache only (no hub calls):
# HF_HUB_OFFLINE=1
# Optional (defaults shown in backend/retrieval/config.py):
# EMBEDDING_DEVICE=cpu
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOC_PREFIX=
# EMBEDDING_BATCH_SIZE=32
# INDEX_DIR=data/index
# CORPUS_DIR=data/corpus
# SEARCH_TOP_K=5
# SEARCH_MIN_SCORE=0
